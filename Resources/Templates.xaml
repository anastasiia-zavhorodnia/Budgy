<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:conv="clr-namespace:Budgy.Converters">

    <conv:SignedAmountConverter x:Key="SignedAmount" />
    <conv:TransactionColorConverter x:Key="TransactionColor" />
    <conv:EnumTextConverter x:Key="EnumText" />

    <!-- Рядок транзакції: використовується на Dashboard, Transactions, AccountDetails -->
    <DataTemplate x:Key="TransactionTemplate">
        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12" Padding="0,8">
            <Border Grid.Column="0" WidthRequest="40" HeightRequest="40"
                    StrokeShape="RoundRectangle 20" Stroke="Transparent"
                    BackgroundColor="{StaticResource PrimarySoft}">
                <Label Text="{Binding Category.Icon}" HorizontalOptions="Center"
                       VerticalOptions="Center" FontSize="18" />
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Text="{Binding Category.Name}" FontAttributes="Bold" />
                <Label Text="{Binding Subtitle}"
                       Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>
            <Label Grid.Column="2" VerticalOptions="Center" FontAttributes="Bold"
                   Text="{Binding ., Converter={StaticResource SignedAmount}}"
                   TextColor="{Binding ., Converter={StaticResource TransactionColor}}" />
        </Grid>
    </DataTemplate>

    <!-- Рядок рахунку -->
    <DataTemplate x:Key="AccountTemplate">
        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12" Padding="0,8">
            <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 10"
                    Stroke="Transparent" BackgroundColor="{StaticResource PrimarySoft}">
                <Label Text="🏦" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Text="{Binding Name}" FontAttributes="Bold" />
                <Label Style="{StaticResource MutedLabel}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding AccountType, Converter={StaticResource EnumText}}" />
                            <Span Text=" · " />
                            <Span Text="{Binding Currency}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>
            <Label Grid.Column="2" Text="{Binding Balance, StringFormat='{0:N0}'}"
                   FontAttributes="Bold" VerticalOptions="Center" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>
