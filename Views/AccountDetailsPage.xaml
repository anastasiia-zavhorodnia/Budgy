<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Budgy.Views.AccountDetailsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="{Binding Account.Name}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Border Style="{StaticResource Card}" BackgroundColor="{StaticResource Navy}" Padding="20">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding Account.BankName}" TextColor="White" FontAttributes="Bold" />
                    <Label Text="{Binding Account.Balance, StringFormat='{0:N0} ₴'}" TextColor="White" FontSize="32" FontAttributes="Bold" />
                    <Label TextColor="#C9C5F5" FontSize="12">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Account.AccountType, Converter={StaticResource EnumText}}" />
                                <Span Text=" · " />
                                <Span Text="{Binding Account.Currency}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Text="Поповнити" Command="{Binding TopUpCommand}" Style="{StaticResource SegmentButton}" />
                <Button Grid.Column="1" Text="Переказ" Command="{Binding TransferCommand}" Style="{StaticResource SegmentButton}" />
                <Button Grid.Column="2" Text="Редагувати" Command="{Binding EditCommand}" Style="{StaticResource SegmentButton}" />
            </Grid>

            <Label Text="Історія операцій" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Account.Transactions}"
                                     BindableLayout.ItemTemplate="{StaticResource TransactionTemplate}" />
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>