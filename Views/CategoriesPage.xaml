<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Budgy.Views.CategoriesPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Budgy.Controls"
             Title="Категорії">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+ Додати категорію" Command="{Binding AddCategoryCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="10">
        <controls:SegmentedControl Segments="Витрати:Expense|Доходи:Income"
                                    SelectedKey="{Binding TypeKey}"
                                    Command="{Binding SetTypeCommand}" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Categories}"
                        SelectionMode="Single" SelectedItem="{Binding SelectedCategory}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="12">
                        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20"
                                    Stroke="Transparent" BackgroundColor="{StaticResource PrimarySoft}">
                                <Label Text="{Binding Icon}" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                <Label Text="{Binding Subcategories.Count, StringFormat='Підкатегорії: {0}'}"
                                       Style="{StaticResource MutedLabel}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="24" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
